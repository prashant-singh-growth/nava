{
  "rewrites": [
    {
      "source": "/vision-ai-industrial-safety",
      "destination": "/vision-ai-industrial-safety.html"
    },
    {
      "source": "/vision-ai-industrial-safety/",
      "destination": "/vision-ai-industrial-safety.html"
    },
    {
      "source": "/vision-ai-dock-operations",
      "destination": "/vision-ai-dock-operations.html"
    },
    {
      "source": "/vision-ai-dock-operations/",
      "destination": "/vision-ai-dock-operations.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
